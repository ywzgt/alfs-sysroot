    ( cd /usr/bin && \
      ln gcc x86_64-pc-linux-gnu-gcc-14.2.0 ); \
  fi; \
  if [ ! -f gcc-cross ] \
      && [ "gcc" != "x86_64-pc-linux-gnu-gcc" ]; then \
    rm -f /usr/bin/x86_64-pc-linux-gnu-gcc-tmp; \
    ( cd /usr/bin && \
