/bin/sh /sources/gcc-14.2.0/libstdc++-v3/../mkinstalldirs /usr/share/locale
catalogs='de.mo fr.mo'; \
for cat in $catalogs; do \
  cat=`basename $cat`; \
  lang=`echo $cat | sed 's/\.mo$//'`; \
  install_dir=/usr/share/locale/$lang/LC_MESSAGES; \
  /bin/sh /sources/gcc-14.2.0/libstdc++-v3/../mkinstalldirs $install_dir; \
  /usr/bin/install -c -m 644 $cat $install_dir/libstdc++.mo; \
done
