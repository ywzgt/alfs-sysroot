	@echo "export OTHER_CPPFLAGS=\"-D_FORTIFY_SOURCE=3 -DNDEBUG\"" >> envars
	@echo "export OTHER_CFLAGS=\"-march=x86-64-v3 -mtune=haswell -O2 -pipe -fno-plt -fPIC -fstack-clash-protection -ffunction-sections -fdata-sections\"" >> envars
